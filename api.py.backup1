@app.put("/api/operator/edit_shift/{shift_id}")
async def edit_shift(shift_id: int, machine: str = Form(...), counter: int = Form(...), set_number: int = Form(...), design_code: str = Form(...), parts: str = Form(...), photo: Optional[UploadFile] = File(None), payload: dict = Depends(verify_token)):
    try:
        async with aiosqlite.connect(DB_NAME) as db:
            async with db.execute("SELECT photo_path, date, shift_type FROM shifts WHERE id=? AND operator_id=?", (shift_id, payload["sub"])) as cursor:
                row = await cursor.fetchone()
                if not row: raise HTTPException(404, "یافت نشد")
                old_photo, date_str, shift_type = row
            final_photo = old_photo
            if photo:
                safe_name = machine.replace(" ", "-")
                photo_path = f"{PHOTO_DIR}/{date_str}_{shift_type}_{payload['sub']}_{safe_name}_edit.jpg"
                contents = await photo.read()
                with open(photo_path, "wb") as buffer: buffer.write(contents)
                final_photo = photo_path
            await db.execute("UPDATE shifts SET machine=?, counter=?, design_code=?, set_number=?, parts=?, photo_path=?, status='pending', zero_reason=NULL WHERE id=?", (machine, counter, design_code, set_number, parts, final_photo, shift_id))
            await db.commit()
            return {"status": "ok"}
    except Exception as e:
        print(f"Error in edit_shift: {e}")
        raise HTTPException(500, str(e))

@app.post("/api/operator/submit_zero")
async def submit_zero(data: ZeroShiftData, payload: dict = Depends(verify_token)):
    if payload.get("role") != "operator": raise HTTPException(403, "دسترسی غیرمجاز")
    try:
        data.date = clean_date(data.date)
        async with aiosqlite.connect(DB_NAME) as db:
            async with db.execute("SELECT id FROM shifts WHERE operator_id=? AND date=? AND shift_type=? AND machine=? AND status IN ('approved', 'pending')", (payload["sub"], data.date, payload.get("shift_type"), data.machine)) as cursor:
                if await cursor.fetchone():
                    raise HTTPException(400, "برای این چرخ و تاریخ قبلا ثبت شده است.")

            await db.execute(
                "INSERT INTO shifts (operator_id, operator_name, date, shift_type, machine, counter, design_code, set_number, parts, photo_path, status, zero_reason, zero_note) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                (payload["sub"], payload["name"], data.date, payload.get("shift_type"), data.machine, 0, "000", 0, "", "", "pending", data.zero_reason, data.zero_note)
            )
            await db.commit()
        return {"status": "ok"}
    except Exception as e:
        print(f"Error in submit_zero: {e}")
        raise HTTPException(500, str(e))

@app.get("/api/operator/stats")
async def get_operator_stats(payload: dict = Depends(verify_token)):
    today = jdatetime.date.today()
    start_date = (today - jdatetime.timedelta(days=6)).strftime("%Y-%m-%d")
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT date, shift_type, machine, counter, set_number, parts, zero_reason FROM shifts WHERE operator_id=? AND status='approved' AND date >= ?", (payload["sub"], start_date)) as cursor:
            rows = await cursor.fetchall()
    daily_work = {}
    for r in rows:
        if r[6]: work = 0
        else: work, _ = await calculate_work_logic(r[2], r[0], r[1], r[3], r[4], r[5])
        if work:
            if r[0] not in daily_work: daily_work[r[0]] = 0
            daily_work[r[0]] += work
    return {"status": "ok", "data": [{"date": d, "work": daily_work[d]} for d in sorted(daily_work.keys())]}

@app.get("/api/operator/reports")
async def get_operator_reports(start_date: str, end_date: str, machine: str = "all", payload: dict = Depends(verify_token)):
    start_date = clean_date(start_date)
    end_date = clean_date(end_date)
    query = "SELECT id, date, shift_type, machine, counter, design_code, set_number, parts, photo_path, zero_reason FROM shifts WHERE operator_id=? AND status='approved' AND date BETWEEN ? AND ?"
    params = [payload["sub"], start_date, end_date]
    if machine != "all":
        query += " AND machine=?"
        params.append(machine)
    query += " ORDER BY date DESC, shift_type DESC"
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute(query, params) as cursor:
            rows = await cursor.fetchall()
    total_work = 0; total_sets = set(); detailed_list = []
    for r in rows:
        if r[9]: # Zero
            work_val = 0
            rank = 0
        else:
            work, _ = await calculate_work_logic(r[3], r[1], r[2], r[4], r[6], r[7])
            work_val = work if work else 0
            if r[6]: total_sets.add(f"{r[5]}-{r[6]}")
            rank = await get_set_monthly_rank(r[3], r[1], r[5], r[6])
            
        total_work += work_val
        detailed_list.append({"id": r[0], "date": r[1], "shift_type": r[2], "machine": r[3], "counter": r[4], "design_code": r[5], "set_number": r[6], "parts": r[7], "photo_path": r[8], "work": work_val, "monthly_set_rank": rank, "zero_reason": r[9]})
    today = jdatetime.date.today()
    start_of_month = today.replace(day=1).strftime("%Y-%m-%d")
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT date, shift_type, machine, counter, set_number, parts, zero_reason FROM shifts WHERE operator_id=? AND status='approved' AND date BETWEEN ? AND ?", (payload["sub"], start_of_month, today.strftime("%Y-%m-%d"))) as cursor:
            month_rows = await cursor.fetchall()
    month_daily_work = {}
    for r in month_rows:
        if r[6]: work = 0
        else: work, _ = await calculate_work_logic(r[2], r[0], r[1], r[3], r[4], r[5])
        if work:
            if r[0] not in month_daily_work: month_daily_work[r[0]] = 0
            month_daily_work[r[0]] += work
    avg_daily = sum(month_daily_work.values()) / len(month_daily_work) if month_daily_work else 0
    return {"summary": {"total_work": total_work, "total_sets": len(total_sets), "avg_daily": int(avg_daily)}, "details": detailed_list}

@app.post("/api/submit_shift")
async def submit_shift(machine: str = Form(...), date: str = Form(...), design_code: str = Form(...), counter: int = Form(...), set_number: int = Form(...), parts: str = Form(...), photo: UploadFile = File(...), payload: dict = Depends(verify_token)):
    if payload.get("role") != "operator": raise HTTPException(403, "دسترسی غیرمجاز")
    try:
        date = clean_date(date)
        contents = await photo.read()
        safe_name = machine.replace(" ", "-")
        photo_path = f"{PHOTO_DIR}/{date}_{payload['shift_type']}_{payload['sub']}_{safe_name}.jpg"
        with open(photo_path, "wb") as buffer: buffer.write(contents)
        async with aiosqlite.connect(DB_NAME) as db:
            await db.execute("INSERT INTO shifts (operator_id, operator_name, date, shift_type, machine, counter, design_code, set_number, parts, photo_path, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", (payload["sub"], payload["name"], date, payload["shift_type"], machine, counter, design_code, set_number, parts, photo_path, "pending"))
            await db.commit()
        return {"status": "ok"}
    except Exception as e:
        print(f"Error in submit_shift: {e}")
        raise HTTPException(500, str(e))

@app.get("/api/admin/users")
async def get_users(payload: dict = Depends(verify_admin)):
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT id, name, phone, role, shift_type FROM users") as cursor:
            return {"users": [{"id": r[0], "name": r[1], "phone": r[2], "role": r[3], "shift_type": r[4]} for r in await cursor.fetchall()]}

@app.post("/api/admin/create_user")
async def create_user(data: CreateUserData, payload: dict = Depends(verify_admin)):
    clean_phone = normalize_phone(data.phone_number)
    pwd_hash = hash_password(data.password)
    final_shift = data.shift_type if data.role == "operator" else None
    async with aiosqlite.connect(DB_NAME) as db:
        try:
            await db.execute("INSERT INTO users (phone, password_hash, name, role, shift_type) VALUES (?, ?, ?, ?, ?)", (clean_phone, pwd_hash, data.name, data.role, final_shift))
            await db.commit()
            return {"status": "ok"}
        except: raise HTTPException(400, "شماره تکراری است")

@app.put("/api/admin/users/{user_id}")
async def update_user(user_id: int, data: UpdateUserData, payload: dict = Depends(verify_admin)):
    async with aiosqlite.connect(DB_NAME) as db:
        if data.password: await db.execute("UPDATE users SET name=?, shift_type=?, password_hash=? WHERE id=?", (data.name, data.shift_type, hash_password(data.password), user_id))
        else: await db.execute("UPDATE users SET name=?, shift_type=? WHERE id=?", (data.name, data.shift_type, user_id))
        await db.commit()
        return {"status": "ok"}

@app.get("/", response_class=HTMLResponse)
async def read_root(): return FileResponse("static/index.html")
