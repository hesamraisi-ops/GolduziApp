@app.get("/api/admin/reports")
async def get_admin_reports(start_date: str, end_date: str, shift: str = "both", payload: dict = Depends(verify_admin)):
    start_date = clean_date(start_date)
    end_date = clean_date(end_date)
    
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT id, operator_name, date, shift_type, machine, counter, design_code, set_number, parts, photo_path, zero_reason, jig_bonus, is_chador, chador_count, chador_invoice FROM shifts WHERE status='approved'") as cursor:
            rows = await cursor.fetchall()
            
    filtered_rows = []
    for r in rows:
        r_date = clean_date(r[2])
        if start_date <= r_date <= end_date:
            if shift == "both" or r[3] == shift:
                filtered_rows.append(r)
                
    filtered_rows.sort(key=lambda x: clean_date(x[2]), reverse=True)
    rows = filtered_rows
    
    total_work = 0; details = []
    machine_sets_dict = {}
    
    for r in rows:
        if r[10]:
            work_val = 0
            rank = 0
        else:
            work, _ = await calculate_work_logic(r[4], r[2], r[3], r[5], r[7], r[8], r[11])
            work_val = work if work is not None else None
            rank = await get_set_monthly_rank(r[4], r[2], r[6], r[7])
            
        mach = r[4]
        if mach not in machine_sets_dict:
            machine_sets_dict[mach] = {'unique': set(), 'bonus': 0}
            
        if r[6] and r[7]:
            machine_sets_dict[mach]['unique'].add(f"{r[6]}-{r[7]}")
        if r[11] and r[11] > 0:
            machine_sets_dict[mach]['bonus'] += 1
            
        if work_val is not None: total_work += work_val
        details.append({"id": r[0], "op_name": r[1], "date": r[2], "day_name": get_day_name(clean_date(r[2])), "shift_type": r[3], "machine": r[4], "counter": r[5], "design_code": r[6], "set_number": r[7], "parts": r[8], "photo_path": r[9], "work": work_val, "monthly_set_rank": rank, "zero_reason": r[10], "jig_bonus": r[11] if len(r)>11 else 0})
    final_machine_sets = {}
    total_sets = 0
    for mach, data in machine_sets_dict.items():
        cnt = len(data['unique']) + data['bonus']
        final_machine_sets[mach] = cnt
        total_sets += cnt

    return {"summary": {"total_work": total_work, "total_sets": total_sets, "machine_sets": final_machine_sets}, "details": details}

@app.get("/api/admin/duration_analysis")
async def get_duration_analysis(payload: dict = Depends(verify_admin)):
    async with aiosqlite.connect(DB_NAME) as db:
        async with db.execute("SELECT machine, design_code, set_number, COUNT(id), MIN(date), MAX(date) FROM shifts WHERE status='approved' AND zero_reason IS NULL GROUP BY machine, design_code, set_number") as cursor:
            rows = await cursor.fetchall()
    stats = {}
    for r in rows:
        mach, design, set_num, shifts, min_d, max_d = r
        y1, m1, d1 = map(int, min_d.split('-'))
        y2, m2, d2 = map(int, max_d.split('-'))
        days_taken = (jdatetime.date(y2, m2, d2) - jdatetime.date(y1, m1, d1)).days + 1
        if mach not in stats: stats[mach] = {}
        if design not in stats[mach]: stats[mach][design] = {'shifts': 0, 'days': 0, 'sets': 0}
        stats[mach][design]['shifts'] += shifts
        stats[mach][design]['days'] += days_taken
        stats[mach][design]['sets'] += 1
    result = {}
    for mach, designs in stats.items():
        result[mach] = {}
        for design, d in designs.items():
            result[mach][design] = {"avg_shifts": round(d['shifts'] / d['sets'], 1), "avg_days": round(d['days'] / d['sets'], 1), "total_sets": d['sets']}
    return {"status": "ok", "data": result}

