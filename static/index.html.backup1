<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#2c3e50">
    <link rel="manifest" href="/static/manifest.json">
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/persian-date@1.1.0/dist/persian-date.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/js/persian-datepicker.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/css/persian-datepicker.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <title>سیستم گلدوزی</title>
    <style>
        @import url('https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css');
        body { font-family: 'Vazirmatn', sans-serif; background-color: #ecf0f1; margin: 0; padding: 20px; color: #333; }
        .container { background-color: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); max-width: 800px; margin: auto; display: none; position: relative; }
        .container.active { display: block; }
        h2 { text-align: center; color: #2c3e50; margin-bottom: 20px; font-size: 20px;}
        .logout-btn { position: absolute; top: 15px; left: 15px; background: #e74c3c; color: white; border: none; padding: 5px 10px; border-radius: 5px; font-size: 12px; cursor: pointer; width: auto; z-index: 10; }
        input, select { width: 100%; padding: 12px; margin-bottom: 15px; border: 1px solid #ccc; border-radius: 8px; box-sizing: border-box; font-family: inherit; font-size: 16px; }
        button { width: 100%; padding: 12px; background-color: #27ae60; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; transition: background 0.3s; margin-bottom: 10px; }
        button:disabled { background-color: #95a5a6; cursor: not-allowed; }
        .admin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 20px; }
        .admin-grid button { height: 70px; display: flex; flex-direction: column; justify-content: center; align-items: center; font-size: 14px;}
        .admin-grid button span { font-size: 24px; margin-bottom: 5px;}
        .btn-confirm { background: #2980b9; } .btn-manual { background: #8e44ad; } .btn-report { background: #d35400; } .btn-analysis { background: #16a085; } .btn-machine { background: #7f8c8d; } .btn-users { background: #2c3e50; } .btn-delete { background: #c0392b; }
        .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;}
        .section-header h3 { margin: 0; }
        .back-btn { background: #95a5a6; width: auto; padding: 8px 15px; margin: 0; font-size: 14px;}
        .chart-container { width: 100%; height: 250px; margin-bottom: 20px; }
        .card { background: #f9f9f9; border: 1px solid #ddd; border-radius: 8px; padding: 15px; margin-bottom: 15px; }
        .card-header { display: flex; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid #eee; padding-bottom: 10px;}
        .card-img { width: 100%; max-height: 200px; object-fit: contain; border-radius: 8px; margin-bottom: 10px; background: #000; }
        .card-actions { display: flex; gap: 10px; margin-top: 10px;}
        .card-actions button { margin: 0; padding: 8px; }
        .tabs { display: flex; gap: 10px; border-bottom: 2px solid #ddd; margin-bottom: 20px; }
        .tab { padding: 10px 20px; cursor: pointer; font-weight: bold; color: #777; }
        .tab.active { color: #2980b9; border-bottom: 3px solid #2980b9; margin-bottom: -2px; }
        .report-item { display: flex; justify-content: space-between; padding: 15px; border-radius: 8px; margin-bottom: 10px; color: white; cursor: pointer;}
        .status-low { background: #e74c3c; } .status-good { background: #2ecc71; } .status-high { background: #f39c12; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 1000; justify-content: center; align-items: center; }
        .modal-content { background: white; padding: 20px; border-radius: 10px; width: 90%; max-width: 500px; max-height: 90vh; overflow-y: auto; }
        .close-modal { background: #e74c3c; margin-top: 15px; }
        .machine-row { display: flex; justify-content: space-between; align-items: center; background: #f1f2f6; padding: 10px; border-radius: 5px; margin-bottom: 10px;}
        .shift-badge { display: inline-block; background: #d1f2eb; color: #117a65; padding: 5px 10px; border-radius: 5px; font-weight: bold; margin-bottom: 15px; font-size: 14px; }
        .dashboard-btns { display: flex; gap: 15px; margin-top: 30px; }
        .dashboard-btns button { height: 100px; font-size: 18px; display: flex; flex-direction: column; justify-content: center; align-items: center; }
        .today-btn { background: #3498db; padding: 8px; font-size: 14px; margin-top: -10px; margin-bottom: 15px; }
        .datepicker-plot-area { font-family: 'Vazirmatn', sans-serif !important; z-index: 99999 !important; }
        #editPhotoPreview { width: 100%; max-height: 150px; object-fit: contain; border-radius: 8px; margin-bottom: 15px; background: #000; display: none;}
        
        .zero-checkbox { display: flex; align-items: center; background: #fdf2f2; border: 1px solid #f5c6cb; padding: 10px; border-radius: 8px; margin-bottom: 15px; cursor: pointer;}
        .zero-checkbox input { width: auto; margin: 0; margin-left: 10px; scale: 1.5; }
        .zero-checkbox label { margin: 0; color: #721c24; cursor: pointer; }
    </style>
</head>
<body>

    <div class="container active" id="loginScreen" style="max-width: 400px;">
        <h2>🔐 ورود به سیستم</h2>
        <input type="tel" id="phone" placeholder="09123456789">
        <input type="password" id="password" placeholder="****">
        <button onclick="doLogin()">ورود</button>
        <div id="loginStatus" style="color: red; text-align:center;"></div>
    </div>

    <div class="container" id="operatorDashboard" style="max-width: 400px;">
        <button class="logout-btn" onclick="doLogout()">خروج</button>
        <h2>🧵 پنل اپراتور</h2>
        <div id="operatorShiftDisplay" style="text-align: center;"></div>
        <div class="chart-container" style="height: 200px;"><canvas id="opChart"></canvas></div>
        <div class="dashboard-btns">
            <button class="btn-manual" onclick="showSection('registerSection')">📝 ثبت کارکرد</button>
            <button class="btn-report" onclick="showSection('opReportsSection'); loadOpReports()">📈 گزارشات</button>
        </div>
    </div>

    <div class="container" id="registerSection" style="max-width: 500px;">
        <div class="section-header">
            <h3 id="formTitle">📝 ثبت کارکرد</h3>
            <button class="back-btn" onclick="showSection('operatorDashboard')">بازگشت</button>
        </div>
        <div id="checkShiftAlert" style="display: none; background: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 15px; text-align: center;">
            ⚠️ برای این چرخ و تاریخ قبلا ثبت شده! <button id="editExistingBtn" style="background: #c82333; margin-top:10px;">✏️ ویرایش کارکرد قبلی</button>
        </div>
        <form id="shiftForm">
            <label>چرخ</label>
            <select id="machine" onchange="checkExistingShift()"></select>

            <label>تاریخ (برای تقویم کلیک کنید)</label>
            <input type="text" id="date" required placeholder="1405-07-01" style="direction: ltr; text-align: right;" onchange="checkExistingShift()">
            <button type="button" class="today-btn" onclick="setTodayDate()">📅 درج سریع تاریخ امروز</button>
            
            <div class="zero-checkbox">
                <input type="checkbox" id="isZeroWork" onchange="toggleZeroMode()">
                <label for="isZeroWork">دستگاه امروز کار نکرده (ثبت کارکرد صفر)</label>
            </div>

            <div id="normalFields">
                <img id="editPhotoPreview" src="">
                <label>شمارنده سوزن</label>
                <input type="number" id="counter" placeholder="1250000">
                <label>کد طرح</label>
                <input type="text" id="design_code" placeholder="206">
                <label>شماره ست</label>
                <input type="number" id="set_number" placeholder="112">
                <label>تکه‌های دوخته شده</label>
                <div class="parts-container" id="parts-container" style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:15px;"></div>
                <label>عکس صفحه دستگاه (دوربین یا گالری)</label>
                <input type="file" id="photo" accept="image/*" style="border:2px dashed #ccc;">
            </div>

            <div id="zeroFields" style="display: none; background: #fff3cd; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                <label style="color: #856404;">علت توقف کار</label>
                <select id="zeroReason">
                    <option value="غیبت">غیبت</option>
                    <option value="خرابی دستگاه">خرابی دستگاه</option>
                    <option value="نبود ست">نبود ست برای دوخت</option>
                    <option value="سایر">سایر</option>
                </select>
                <label style="color: #856404;">توضیحات بیشتر (اختیاری)</label>
                <input type="text" id="zeroNote" placeholder="توضیح دهید...">
            </div>

            <button type="submit" id="submitBtn">ارسال به مدیر</button>
        </form>
    </div>

    <div class="container" id="opReportsSection">
        <div class="section-header"><h3>📈 گزارشات من</h3><button class="back-btn" onclick="showSection('operatorDashboard')">بازگشت</button></div>
        <div class="tabs">
            <div class="tab active" id="tabOpGen" onclick="switchOpTab('general')">گزارش کلی</div>
            <div class="tab" id="tabOpDet" onclick="switchOpTab('detail')">ریز گزارش</div>
        </div>
        <div style="display:flex; gap:10px; margin-bottom:15px;">
            <input type="text" id="opStartDate" placeholder="از تاریخ">
            <input type="text" id="opEndDate" placeholder="تا تاریخ">
            <button style="margin:0; width:80px;" onclick="loadOpReports()">فیلتر</button>
        </div>
        <div id="opGeneralContent">
            <div class="card"><h4>جمع کارکرد</h4><h2 id="opSumWork">0</h2></div>
            <div class="card"><h4>جمع ست</h4><h2 id="opSumSets">0</h2></div>
            <div class="card"><h4>میانگین روزانه</h4><h2 id="opAvgDaily">0</h2></div>
        </div>
        <div id="opDetailContent" style="display:none;"></div>
    </div>

    <div class="container" id="adminScreen">
        <button class="logout-btn" onclick="doLogout()">خروج</button>
        <h2>👑 پنل مدیر کل</h2>
        <div class="chart-container"><canvas id="adminChart"></canvas></div>
        <div class="admin-grid">
            <button class="btn-confirm" onclick="showSection('adminConfirmSection'); loadPendingShifts()"><span>✅</span> تایید کارکرد</button>
            <button class="btn-manual" onclick="showSection('adminManualSection')"><span>📝</span> ثبت دستی</button>
            <button class="btn-report" onclick="showSection('adminReportsSection'); loadAdminReports()"><span>📈</span> گزارشات کلی</button>
            <button class="btn-analysis" onclick="showSection('adminAnalysisSection'); loadAnalysis()"><span>⏱</span> تحلیل زمان دوخت</button>
            <button class="btn-machine" onclick="showSection('adminMachineSection'); loadAdminMachines()"><span>⚙️</span> تنظیمات چرخ</button>
            <button class="btn-users" onclick="showSection('adminUserSection'); loadUsers()"><span>👥</span> تنظیمات کاربران</button>
            <button class="btn-delete" style="grid-column: span 2;" onclick="showSection('adminDeleteSection'); loadDeleteList()"><span>🗑</span> حذف کارکرد</button>
        </div>
    </div>

    <div class="container" id="adminConfirmSection">
        <div class="section-header"><h3>✅ تایید کارکرد</h3><button class="back-btn" onclick="showSection('adminScreen')">بازگشت</button></div>
        <div id="pendingList"></div>
    </div>

    <div class="container" id="adminManualSection" style="max-width: 500px;">
        <div class="section-header"><h3>📝 ثبت دستی</h3><button class="back-btn" onclick="showSection('adminScreen')">بازگشت</button></div>
        <form id="manualForm">
            <select id="manOpId" required></select>
            <input type="text" id="manDate" required placeholder="تاریخ">
            <select id="manShift" required><option value="صبح">صبح</option><option value="شب">شب</option></select>
            <select id="manMachine" required></select>
            <input type="number" id="manCounter" required placeholder="شمارنده">
            <input type="text" id="manDesign" required placeholder="کد طرح">
            <input type="number" id="manSetNum" required placeholder="شماره ست">
            <input type="text" id="manParts" placeholder="تکه‌ها">
            <button type="submit" style="background:#8e44ad;">ثبت</button>
        </form>
    </div>

    <div class="container" id="adminReportsSection">
        <div class="section-header"><h3>📈 گزارشات</h3><button class="back-btn" onclick="showSection('adminScreen')">بازگشت</button></div>
        <div class="tabs">
            <div class="tab active" id="tabAdmGen" onclick="switchAdmTab('general')">کلی</div>
            <div class="tab" id="tabAdmDet" onclick="switchAdmTab('detail')">ریز</div>
        </div>
        <div style="display:flex; gap:10px; margin-bottom:15px;">
            <input type="text" id="admStartDate" placeholder="از تاریخ">
            <input type="text" id="admEndDate" placeholder="تا تاریخ">
            <button style="margin:0; width:80px;" onclick="loadAdminReports()">فیلتر</button>
        </div>
        <div id="admGeneralContent">
            <div class="card"><h4>جمع کل</h4><h2 id="admSumWork">0</h2></div>
            <div class="card"><h4>جمع ست‌ها</h4><h2 id="admSumSets">0</h2></div>
        </div>
        <div id="admDetailContent" style="display:none;"></div>
    </div>

    <div class="container" id="adminAnalysisSection">
        <div class="section-header"><h3>⏱ تحلیل</h3><button class="back-btn" onclick="showSection('adminScreen')">بازگشت</button></div>
        <div id="analysisData"></div>
    </div>

    <div class="container" id="adminMachineSection">
        <div class="section-header"><h3>⚙️ چرخ‌ها</h3><button class="back-btn" onclick="showSection('adminScreen')">بازگشت</button></div>
        <div style="display:flex; gap:10px; margin-bottom:15px;">
            <input type="text" id="newMachineName" placeholder="نام چرخ" style="margin:0;">
            <button style="margin:0; width:100px;" onclick="addMachine()">افزودن</button>
        </div>
        <div id="machineList"></div>
    </div>

    <div class="container" id="adminUserSection">
        <div class="section-header"><h3>👥 کاربران</h3><button class="back-btn" onclick="showSection('adminScreen')">بازگشت</button></div>
        <div class="card" style="background:#e8f8f5;">
            <input type="text" id="newName" placeholder="نام">
            <input type="tel" id="newPhone" placeholder="شماره">
            <input type="password" id="newPassword" placeholder="رمز">
            <select id="newRole" onchange="toggleCreateShift()"><option value="operator">اپراتور</option><option value="admin">مدیر</option></select>
            <div id="createShiftDiv"><select id="newShift"><option value="صبح">صبح</option><option value="شب">شب</option></select></div>
            <button style="background:#2c3e50;" onclick="createUser()">ایجاد</button>
        </div>
        <div id="usersList"></div>
    </div>

    <div class="container" id="adminDeleteSection">
        <div class="section-header"><h3>🗑 حذف</h3><button class="back-btn" onclick="showSection('adminScreen')">بازگشت</button></div>
        <div id="deleteList"></div>
    </div>

    <div class="modal" id="detailModal">
        <div class="modal-content">
            <img id="modalPhoto" src="" style="width:100%; border-radius:8px; margin-bottom:15px;">
            <div id="modalDetails" style="font-size:14px; line-height: 1.8;"></div>
            <button class="close-modal" onclick="document.getElementById('detailModal').style.display='none'">بستن</button>
        </div>
    </div>

    <script>
        let authToken = localStorage.getItem('token');
        let userRole = localStorage.getItem('role');
        let userShift = localStorage.getItem('shift_type');
        let adminChartInst = null, opChartInst = null;
        let editingShiftId = null;

        $(document).ready(function() {
            try {
                $('#date').persianDatepicker({ format: 'YYYY-MM-DD', autoClose: true, onSelect: function() { checkExistingShift(); } });
                $('#date').on('click', function() { $(this).persianDatepicker('show'); });
            } catch (e) { console.log("Datepicker error"); }

            const partsList = ["جیگ", "پشت بدن", "آستین", "تک", "شلوار", "پندول", "سریگ"];
            const partsContainer = document.getElementById('parts-container');
            partsList.forEach(part => {
                const label = document.createElement('label');
                label.className = 'part-label';
                label.innerHTML = `<input type="checkbox" value="${part}"> ${part}`;
                partsContainer.appendChild(label);
            });

            routeUser();
        });

        function showSection(id) {
            document.querySelectorAll('.container').forEach(c => c.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            if(id === 'adminScreen') loadAdminDashboard();
        }

        function doLogout() { localStorage.clear(); location.reload(); }

        async function doLogin() {
            const res = await fetch('/api/login', {
                method: 'POST', headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({phone_number: document.getElementById('phone').value, password: document.getElementById('password').value})
            });
            const data = await res.json();
            if (res.ok) {
                localStorage.setItem('token', data.token); localStorage.setItem('role', data.role); localStorage.setItem('shift_type', data.shift_type || '');
                authToken = data.token; userRole = data.role; userShift = data.shift_type; location.reload();
            } else { document.getElementById('loginStatus').innerText = data.detail || "خطا"; }
        }

        function routeUser() {
            document.querySelectorAll('.container').forEach(c => c.classList.remove('active'));
            if (!authToken) showSection('loginScreen');
            else if (userRole === 'admin') showSection('adminScreen');
            else {
                showSection('operatorDashboard');
                document.getElementById('operatorShiftDisplay').innerHTML = `<div class="shift-badge">شیفت شما: ${userShift}</div>`;
                loadMachines();
                loadOpChart();
            }
        }

        function setTodayDate() {
            fetch('/api/today').then(r => r.json()).then(d => {
                document.getElementById('date').value = d.date;
                checkExistingShift();
            });
        }

        async function loadMachines() {
            const res = await fetch('/api/machines', { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            const select = document.getElementById('machine');
            if(select) select.innerHTML = data.machines.map(m => `<option value="${m}">${m}</option>`).join('');
            checkExistingShift();
        }

        async function loadOpChart() {
            const res = await fetch('/api/operator/stats', { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            if (!data.data || data.data.length === 0) return;
            if (opChartInst) opChartInst.destroy();
            opChartInst = new Chart(document.getElementById('opChart'), {
                type: 'bar',
                data: { labels: data.data.map(d => d.date), datasets: [{ data: data.data.map(d => d.work), backgroundColor: '#3498db' }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });
        }

        async function checkExistingShift() {
            const date = document.getElementById('date').value;
            const machine = document.getElementById('machine').value;
            if (!date || !machine) return;

            const res = await fetch(`/api/operator/check_shift?date=${date}&machine=${encodeURIComponent(machine)}`, { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            
            if (data.status === 'exists') {
                document.getElementById('checkShiftAlert').style.display = 'block';
                document.getElementById('editExistingBtn').onclick = () => loadShiftForEdit(data.shift_id);
                document.getElementById('shiftForm').style.display = 'none';
            } else {
                resetForm();
            }
        }

        function resetForm() {
            document.getElementById('checkShiftAlert').style.display = 'none';
            document.getElementById('shiftForm').style.display = 'block';
            document.getElementById('formTitle').innerText = "📝 ثبت کارکرد";
            editingShiftId = null;
            document.getElementById('submitBtn').innerText = "ارسال به مدیر";
            document.getElementById('photo').required = true;
            document.getElementById('editPhotoPreview').style.display = 'none';
            document.getElementById('isZeroWork').checked = false;
            toggleZeroMode();
        }

        function toggleZeroMode() {
            const isZero = document.getElementById('isZeroWork').checked;
            if (isZero) {
                document.getElementById('normalFields').style.display = 'none';
                document.getElementById('zeroFields').style.display = 'block';
                document.getElementById('photo').required = false;
            } else {
                document.getElementById('normalFields').style.display = 'block';
                document.getElementById('zeroFields').style.display = 'none';
                document.getElementById('photo').required = !editingShiftId;
            }
        }

        async function loadShiftForEdit(id) {
            editingShiftId = id;
            const res = await fetch(`/api/operator/shift/${id}`, { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            if (res.ok) {
                document.getElementById('formTitle').innerText = "✏️ ویرایش کارکرد";
                document.getElementById('machine').value = data.data.machine;
                
                if(data.data.zero_reason) {
                    document.getElementById('isZeroWork').checked = true;
                    document.getElementById('zeroReason').value = data.data.zero_reason;
                    document.getElementById('zeroNote').value = data.data.zero_note || '';
                    toggleZeroMode();
                } else {
                    document.getElementById('isZeroWork').checked = false;
                    toggleZeroMode();
                    document.getElementById('counter').value = data.data.counter;
                    document.getElementById('design_code').value = data.data.design;
                    document.getElementById('set_number').value = data.data.set_number;
                }

                if(data.data.photo_path) {
                    document.getElementById('editPhotoPreview').src = '/' + data.data.photo_path;
                    document.getElementById('editPhotoPreview').style.display = 'block';
                } else {
                    document.getElementById('editPhotoPreview').style.display = 'none';
                }

                document.getElementById('checkShiftAlert').style.display = 'none';
                document.getElementById('shiftForm').style.display = 'block';
                document.getElementById('submitBtn').innerText = "ذخیره تغییرات";
            }
        }

        document.getElementById('shiftForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('submitBtn');
            const dateVal = document.getElementById('date').value;
            const machineVal = document.getElementById('machine').value;
            const isZero = document.getElementById('isZeroWork').checked;
            
            if (!dateVal) { alert("تاریخ را وارد کنید"); return; }
            
            btn.disabled = true; btn.innerText = "در حال ارسال...";

            if (isZero) {
                const zeroPayload = {
                    date: dateVal,
                    machine: machineVal,
                    zero_reason: document.getElementById('zeroReason').value,
                    zero_note: document.getElementById('zeroNote').value
                };
                const res = await fetch('/api/operator/submit_zero', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${authToken}` },
                    body: JSON.stringify(zeroPayload)
                });
                if (res.ok) { alert("✅ کارکرد صفر ثبت شد!"); showSection('operatorDashboard'); }
                else { const d = await res.json(); alert("❌ خطا: " + d.detail); }
            } else {
                const photoFile = document.getElementById('photo').files[0];
                if (!photoFile && !editingShiftId) { alert("لطفا عکس را انتخاب کنید"); btn.disabled = false; btn.innerText = "ارسال"; return; }

                const fd = new FormData();
                fd.append("date", dateVal);
                fd.append("machine", machineVal);
                fd.append("counter", document.getElementById('counter').value);
                fd.append("design_code", document.getElementById('design_code').value);
                fd.append("set_number", document.getElementById('set_number').value);
                const checkboxes = document.querySelectorAll('#parts-container input:checked');
                fd.append("parts", Array.from(checkboxes).map(cb => cb.value).join(","));
                if (photoFile) fd.append("photo", photoFile);

                const url = editingShiftId ? `/api/operator/edit_shift/${editingShiftId}` : '/api/submit_shift';
                const method = editingShiftId ? 'PUT' : 'POST';

                const res = await fetch(url, { method, headers: { 'Authorization': `Bearer ${authToken}` }, body: fd });
                if (res.ok) { alert("✅ ثبت شد!"); showSection('operatorDashboard'); }
                else { alert("❌ خطا در ثبت"); }
            }
            btn.disabled = false; btn.innerText = editingShiftId ? "ذخیره تغییرات" : "ارسال به مدیر";
        });

        function switchOpTab(tab) { loadOpReports(); }

        async function loadOpReports() {
            let start = document.getElementById('opStartDate').value || new persianDate().format('YYYY-MM-01');
            let end = document.getElementById('opEndDate').value || new persianDate().format('YYYY-MM-DD');
            const res = await fetch(`/api/operator/reports?start_date=${start}&end_date=${end}`, { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            document.getElementById('opSumWork').innerText = data.summary.total_work.toLocaleString();
            document.getElementById('opSumSets').innerText = data.summary.total_sets;
            document.getElementById('opAvgDaily').innerText = data.summary.avg_daily.toLocaleString();
            const div = document.getElementById('opDetailContent'); div.innerHTML = '';
            data.details.forEach(d => {
                if(d.zero_reason) {
                    div.innerHTML += `<div class="report-item" style="background:#7f8c8d;" onclick='openModal(${JSON.stringify(d)})'><div><strong>${d.date}</strong><br>${d.machine} | کارکرد صفر</div><div><strong>0</strong></div></div>`;
                } else {
                    let cls = d.work < 250000 ? 'status-low' : (d.work <= 320000 ? 'status-good' : 'status-high');
                    div.innerHTML += `<div class="report-item ${cls}" onclick='openModal(${JSON.stringify(d)})'><div><strong>${d.date}</strong><br>${d.machine} | ${d.shift_type}</div><div><strong>${d.work.toLocaleString()}</strong></div></div>`;
                }
            });
        }

        async function loadAdminDashboard() {
            const res = await fetch('/api/admin/stats', { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            if (adminChartInst) adminChartInst.destroy();
            adminChartInst = new Chart(document.getElementById('adminChart'), {
                type: 'bar', data: { labels: data.labels, datasets: [{ label: 'صبح', data: data.morning, backgroundColor: '#f1c40f' }, { label: 'شب', data: data.night, backgroundColor: '#34495e' }] }
            });
        }

        async function loadPendingShifts() {
            const res = await fetch('/api/admin/pending_shifts', { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            const div = document.getElementById('pendingList'); div.innerHTML = '';
            if (data.shifts.length === 0) div.innerHTML = '<p style="text-align:center;">لیست خالی است.</p>';
            
            data.shifts.forEach(s => {
                let content = "";
                if (s.zero_reason) {
                    content = `
                        <div style="font-size:14px; line-height: 1.6; color:#c0392b;">
                            چرخ: <strong>${s.machine}</strong><br>
                            ⚠️ ثبت کارکرد صفر: <strong>${s.zero_reason}</strong><br>
                            توضیحات: ${s.zero_note || 'ندارد'}
                        </div>`;
                } else {
                    content = `
                        <img class="card-img" src="/${s.photo || 'static/placeholder.png'}">
                        <div style="font-size:14px; line-height: 1.6;">
                            چرخ: <strong>${s.machine}</strong> | شمارنده: ${s.counter}<br>
                            طرح: ${s.design} | شماره ست: ${s.set_num} <span style="color:#e74c3c; font-weight:bold;">(ست ${s.monthly_set_rank} این ماه)</span><br>
                            تکه‌ها: <strong>${s.parts || 'ثبت نشده'}</strong>
                        </div>`;
                }
                
                div.innerHTML += `
                <div class="card">
                    <div class="card-header"><strong>${s.op_name}</strong><span>${s.date} | ${s.shift}</span></div>
                    ${content}
                    <div class="card-actions">
                        <button style="background:#2ecc71;" onclick="fetch('/api/admin/approve_shift/${s.id}',{method:'POST',headers:{'Authorization':'Bearer ${authToken}'}}).then(()=>loadPendingShifts())">✅ تایید</button>
                        <button style="background:#e74c3c;" onclick="fetch('/api/admin/reject_shift/${s.id}',{method:'POST',headers:{'Authorization':'Bearer ${authToken}'}}).then(()=>loadPendingShifts())">❌ رد</button>
                    </div>
                </div>`;
            });
        }

        async function loadAdminMachines() {
            const res = await fetch('/api/admin/machines', { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            const div = document.getElementById('machineList'); div.innerHTML = '';
            data.machines.forEach(m => {
                div.innerHTML += `<div class="machine-row"><strong>${m.name}</strong><div style="display:flex; gap:5px;"><input type="number" id="reset_${m.name}" value="${m.reset_period}" style="width:100px; margin:0;"><input type="number" id="start_${m.name}" value="${m.start_counter}" style="width:100px; margin:0;"><button style="margin:0; padding:5px;" onclick="fetch('/api/admin/machines/${m.name}',{method:'PUT',headers:{'Content-Type':'application/json', 'Authorization':'Bearer ${authToken}'}, body: JSON.stringify({reset_period: parseInt(document.getElementById('reset_${m.name}').value), start_counter: parseInt(document.getElementById('start_${m.name}').value)})}).then(()=>alert('ذخیره شد'))">ذخیره</button></div></div>`;
            });
        }

        async function addMachine() {
            const name = document.getElementById('newMachineName').value;
            if(!name) return alert("نام چرخ را وارد کنید");
            const res = await fetch('/api/admin/machines', {method:'POST', headers:{'Content-Type':'application/json', 'Authorization':`Bearer ${authToken}`}, body: JSON.stringify({name})});
            if(res.ok) { document.getElementById('newMachineName').value = ''; loadAdminMachines(); alert("اضافه شد"); }
            else { alert("خطا در اضافه کردن"); }
        }

        async function loadAnalysis() {
            const res = await fetch('/api/admin/duration_analysis', { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            const div = document.getElementById('analysisData'); div.innerHTML = '';
            for (const [mach, designs] of Object.entries(data.data)) {
                let html = `<h3>🧵 ${mach}</h3>`;
                for (const [design, stats] of Object.entries(designs)) {
                    html += `<div class="card">طرح ${design}: ${stats.total_sets} ست | میانگین ${stats.avg_shifts} شیفت (${stats.avg_days} روز)</div>`;
                }
                div.innerHTML += html;
            }
        }

        async function loadAdminReports() {
            let start = document.getElementById('admStartDate').value || new persianDate().format('YYYY-MM-01');
            let end = document.getElementById('admEndDate').value || new persianDate().format('YYYY-MM-DD');
            const res = await fetch(`/api/admin/reports?start_date=${start}&end_date=${end}`, { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            document.getElementById('admSumWork').innerText = data.summary.total_work.toLocaleString();
            document.getElementById('admSumSets').innerText = data.summary.total_sets;
            const div = document.getElementById('admDetailContent'); div.innerHTML = '';
            data.details.forEach(d => {
                if(d.zero_reason) {
                     div.innerHTML += `<div class="report-item" style="background:#7f8c8d;" onclick='openModal(${JSON.stringify(d)})'><div><strong>${d.date} | ${d.op_name}</strong><br>${d.machine} | کارکرد صفر</div><div><strong>0</strong></div></div>`;
                } else {
                    let cls = d.work < 250000 ? 'status-low' : (d.work <= 320000 ? 'status-good' : 'status-high');
                    div.innerHTML += `<div class="report-item ${cls}" onclick='openModal(${JSON.stringify(d)})'><div><strong>${d.date} | ${d.op_name}</strong><br>${d.machine} | ${d.shift_type}</div><div><strong>${d.work.toLocaleString()}</strong></div></div>`;
                }
            });
        }

        function switchAdmTab(tab) { loadAdminReports(); }

        async function loadDeleteList() {
            const res = await fetch('/api/admin/reports?start_date=2000-01-01&end_date=2099-12-31', { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            const div = document.getElementById('deleteList'); div.innerHTML = '';
            data.details.slice(0, 50).forEach(d => {
                div.innerHTML += `<div class="machine-row"><div>${d.date} | ${d.op_name} | ${d.machine}</div><button style="background:#e74c3c; width:60px;" onclick="if(confirm('حذف شود؟')) fetch('/api/admin/delete_shift/${d.id}', {method:'DELETE', headers:{'Authorization':'Bearer ${authToken}'}}).then(()=>loadDeleteList())">حذف</button></div>`;
            });
        }

        document.getElementById('manualForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const res = await fetch('/api/admin/manual_shift', {
                method: 'POST', headers: {'Content-Type': 'application/json', 'Authorization': `Bearer ${authToken}`},
                body: JSON.stringify({
                    operator_id: parseInt(document.getElementById('manOpId').value),
                    date: document.getElementById('manDate').value,
                    shift_type: document.getElementById('manShift').value,
                    machine: document.getElementById('manMachine').value,
                    counter: parseInt(document.getElementById('manCounter').value),
                    design_code: document.getElementById('manDesign').value,
                    set_number: parseInt(document.getElementById('manSetNum').value),
                    parts: document.getElementById('manParts').value
                })
            });
            if(res.ok) { alert("✅ ثبت شد"); document.getElementById('manualForm').reset(); }
        });

        function toggleCreateShift() { document.getElementById('createShiftDiv').style.display = document.getElementById('newRole').value === 'operator' ? 'block' : 'none'; }
        
        async function loadUsers() {
            const res = await fetch('/api/admin/users', { headers: { 'Authorization': `Bearer ${authToken}` } });
            const data = await res.json();
            const div = document.getElementById('usersList'); div.innerHTML = '';
            const select = document.getElementById('manOpId'); select.innerHTML = '';
            data.users.forEach(u => {
                div.innerHTML += `<div class="machine-row"><div><strong>${u.name}</strong><br>${u.phone} | ${u.role} ${u.shift_type ? '| '+u.shift_type : ''}</div><button style="background:#f39c12; width:60px;" onclick="editUser(${u.id},'${u.name}','${u.shift_type}','${u.role}')">ویرایش</button></div>`;
                if(u.role === 'operator') select.innerHTML += `<option value="${u.id}">${u.name}</option>`;
            });
        }

        function editUser(id, name, shift, role) {
            const newName = prompt("نام جدید را وارد کنید:", name);
            if (newName) {
                const newShift = role === 'operator' ? prompt("شیفت جدید (صبح یا شب):", shift) : null;
                if (role !== 'operator' || (newShift === 'صبح' || newShift === 'شب')) {
                    fetch(`/api/admin/users/${id}`, {method:'PUT', headers:{'Content-Type':'application/json', 'Authorization':`Bearer ${authToken}`}, body: JSON.stringify({name: newName, shift_type: newShift})}).then(()=>loadUsers());
                }
            }
        }

        async function createUser() {
            const body = {
                name: document.getElementById('newName').value,
                phone_number: document.getElementById('newPhone').value,
                password: document.getElementById('newPassword').value,
                role: document.getElementById('newRole').value,
                shift_type: document.getElementById('createShiftDiv').style.display !== 'none' ? document.getElementById('newShift').value : null
            };
            const res = await fetch('/api/admin/create_user', {method:'POST', headers:{'Content-Type':'application/json', 'Authorization':`Bearer ${authToken}`}, body: JSON.stringify(body)});
            if(res.ok) loadUsers(); else alert("خطا در ساخت");
        }

        function openModal(d) {
            if(d.zero_reason) {
                document.getElementById('modalPhoto').style.display = 'none';
                document.getElementById('modalDetails').innerHTML = `<strong>تاریخ:</strong> ${d.date} | ${d.shift_type}<br><strong>چرخ:</strong> ${d.machine}<br><strong style="color:red;">⚠️ کارکرد صفر: ${d.zero_reason}</strong><br><strong>توضیحات:</strong> ${d.zero_note || 'ندارد'}`;
            } else {
                document.getElementById('modalPhoto').style.display = 'block';
                document.getElementById('modalPhoto').src = '/' + (d.photo_path || 'static/placeholder.png');
                document.getElementById('modalDetails').innerHTML = `<strong>تاریخ:</strong> ${d.date} | ${d.shift_type}<br><strong>چرخ:</strong> ${d.machine}<br><strong>کارکرد:</strong> ${d.work.toLocaleString()}<br><strong>شمارنده:</strong> ${d.counter}<br><strong>طرح/ست:</strong> ${d.design_code} / ${d.set_number} (ست ${d.monthly_set_rank || '؟'} ماه)<br><strong>تکه‌ها:</strong> ${d.parts || 'ثبت نشده'}`;
            }
            document.getElementById('detailModal').style.display = 'flex';
        }
    </script>
</body>
</html>
